{
  "name": "drizzle-drawdb",
  "version": "0.1.0",
  "description": "Open the real drawDB editor with a PostgreSQL schema exported from a Drizzle ORM project.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "drizzle-drawdb": "./dist/cli.js"
  },
  "files": [
    "dist",
    "patches",
    "README.md"
  ],
  "scripts": {
    "build:importer": "node scripts/build-importer.mjs",
    "build:cli": "node scripts/build-cli.mjs",
    "build": "npm run build:importer && npm run build:cli",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:importer && bun test",
    "test:browser": "bun test test/browser.test.ts"
  },
  "dependencies": {
    "jiti": "^2.4.2",
    "node-sql-parser": "5.4.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.64.0",
    "typescript": "^5.7.0"
  }
}
