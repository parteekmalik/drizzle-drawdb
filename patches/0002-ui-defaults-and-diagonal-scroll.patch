diff --git a/src/components/EditorCanvas/Canvas.jsx b/src/components/EditorCanvas/Canvas.jsx
index b1fad48..277d5bd 100644
--- a/src/components/EditorCanvas/Canvas.jsx
+++ b/src/components/EditorCanvas/Canvas.jsx
@@ -734,20 +734,18 @@ export default function Canvas() {
           },
           zoom: e.deltaY <= 0 ? prev.zoom * 1.05 : prev.zoom / 1.05,
         }));
-      } else if (e.shiftKey) {
-        setTransform((prev) => ({
-          ...prev,
-          pan: {
-            ...prev.pan,
-            x: prev.pan.x + e.deltaY / prev.zoom,
-          },
-        }));
       } else {
+        // Trackpads report both axes in deltaX/deltaY, so honouring them
+        // together enables diagonal panning. Browsers fold a horizontal swipe
+        // into deltaY when Shift is held and report deltaX as 0, so fall back
+        // to that when there is no horizontal delta (i.e. a mouse wheel).
+        const hasHorizontalDelta = Math.abs(e.deltaX) > 0;
+
         setTransform((prev) => ({
           ...prev,
           pan: {
-            ...prev.pan,
-            y: prev.pan.y + e.deltaY / prev.zoom,
+            x: prev.pan.x + (e.shiftKey && !hasHorizontalDelta ? e.deltaY : e.deltaX) / prev.zoom,
+            y: prev.pan.y + (e.shiftKey && !hasHorizontalDelta ? 0 : e.deltaY) / prev.zoom,
           },
         }));
       }
